# ─── Supabase (required) ─────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Product analytics (optional, no-op when empty) ──────────────
# PostHog project API key (starts with phc_)
VITE_POSTHOG_KEY=
# US cloud by default; use https://eu.i.posthog.com for EU
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── Error tracking (optional) ───────────────────────────────────
# Sentry DSN from Settings → Projects → Client Keys
VITE_SENTRY_DSN=
# Used for environment tagging and release tracking
VITE_APP_ENV=development
VITE_APP_RELEASE=

# ─── Paid traffic attribution (optional) ─────────────────────────
# Meta Pixel ID (numeric). Leave empty locally so no fbq loads.
VITE_META_PIXEL_ID=
